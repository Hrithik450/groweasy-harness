{
  "name": "@openai-harness/root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,gateway -c blue,green \"pnpm --filter @openai-harness/web dev\" \"pnpm dev:server\"",
    "dev:web": "pnpm --filter @openai-harness/web dev",
    "dev:server": "tsx watch apps/gateway/src/index.ts",
    "start:server": "tsx apps/gateway/src/index.ts",
    "build": "pnpm build:lib && pnpm --filter @openai-harness/web build",
    "build:lib": "node scripts/build-packages.mjs",
    "build:web": "pnpm --filter @openai-harness/web build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@aryanjsx/knowindia": "^1.2.4",
