# uno.mhrithik.com — local origin for the Cloudflare Tunnel.
#
# Cloudflare terminates TLS at the edge and forwards plain HTTP to :8080, so
# this server runs without certificates. The tunnel is the only way in; the
# port is bound to localhost.
{
	auto_https off
	admin off
	# Caddy's default shutdown waits for every open connection, which means a
	# live log stream (/_logs/api/stream) keeps it alive forever and a restart
	# never finishes. Five seconds is the ceiling: in-flight requests finish,
	# idle streams are dropped and reconnect on their own.
	grace_period 5s
}

:8080 {
	log {
		output file __HARNESS_ROOT__/logs/caddy.log {
			roll_size 20mb
			roll_keep 5
		}
		# JSON: the shape GoAccess's CADDY format parses, and it keeps every
		# field Caddy records (the client IP is request.headers.Cf-Connecting-Ip,
		# since {remote_host} is always the tunnel process itself).
		format json
	}

	encode zstd gzip

	# Log viewer at /_logs/ (basic auth). Caddy is the only authentication
	# here; the viewer binds 127.0.0.1 and must never be exposed directly.
	handle_path /_logs* {
		basic_auth {
			admin $2a$14$E8Kffmge4CwTjqaigCi2o.92pN7BMzTHRKh1KP3D9YeE3Vzz9Pw7G
		}
		reverse_proxy 127.0.0.1:7890
	}

	# Unary RPC (POST /api/<ns>/<method>), the /api/remote.mux WebSocket, and
	# authenticated attachment delivery all live on the Gateway.
	handle /api/* {
		reverse_proxy 127.0.0.1:4000 {
			# Long-lived mux sockets: no proxy-side read deadline, and no
			# response buffering.
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# Built bundle. `try_files` sends client routes such as /c/<threadId> to
	# the SPA shell instead of 404ing.
	handle {
		root * __HARNESS_ROOT__/release/current/web
		try_files {path} /index.html
		file_server
	}
}
