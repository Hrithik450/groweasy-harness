    "lib/index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/agent": "workspace:*",
    "@openai-harness/agent-loop": "workspace:*",
    "@openai-harness/generative-ui": "workspace:*",
    "@openai-harness/llm": "workspace:*",
    "@openai-harness/session": "workspace:*",
    "@openai-harness/uuid": "workspace:*",
    "openai": "^7.43.0"
  }
