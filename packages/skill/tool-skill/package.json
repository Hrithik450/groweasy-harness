{
  "name": "@openai-harness/tool-skill",
  "description": "Model-facing skill loader tool over a host-supplied skill registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/llm": "workspace:*",
    "@openai-harness/skill": "workspace:*",
    "@openai-harness/tools": "workspace:*"
  }
}
