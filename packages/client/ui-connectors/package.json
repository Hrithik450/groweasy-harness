{
  "name": "@openai-harness/client-ui-connectors",
  "description": "Connector manager overlays: Meta Ads, Shopify, and Business Profile managers registered into the shell overlay slot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.d.ts",
    "src"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@openai-harness/client-ui-renderer": "workspace:*",
    "@openai-harness/client-ui-slots": "workspace:*",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@aryanjsx/knowindia": "^1.2.4",
    "@openai-harness/client-ui-attachment-viewers": "workspace:*",
    "@openai-harness/client-ui-chat": "workspace:*",
    "@openai-harness/client-ui-session": "workspace:*",
    "countries-list": "^3.4.1",
    "country-state-city": "^3.2.1",
    "lucide-react": "^1.61.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "@openai-harness/client-ui-renderer": "workspace:*",
    "@openai-harness/client-ui-slots": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@openai-harness/client-ui-renderer": "workspace:*",
    "@openai-harness/client-ui-slots": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.22.14"
  }
}
