{
  "name": "@openai-harness/client-ui-session",
  "description": "Framework-light client state layer for the browser UI packages: Zustand stores plus the chat-stream and business-profile hooks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/generative-ui": "workspace:*",
    "@openai-harness/session": "workspace:*",
    "@openai-harness/session-projection": "workspace:*",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "react": "19.3.0"
  }
}
