{
  "name": "@openai-harness/client-ui-layout",
  "description": "App frame as a slot plugin: the root shell frame and its sidebar, main, rightbar, and overlay seats",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/*.d.ts",
    "src"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "react": "19.3.0"
  },
  "dependencies": {
    "@openai-harness/client-ui-primitives": "workspace:*",
    "@openai-harness/client-ui-renderer": "workspace:*",
    "@openai-harness/client-ui-slots": "workspace:*",
    "@openai-harness/session": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.22.14"
  }
}
