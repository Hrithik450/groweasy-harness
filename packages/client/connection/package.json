{
  "name": "@openai-harness/client-connection",
  "description": "Connection wire contracts, Peer scopes, the node:http bridge, and the browser unary RPC caller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.browser.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.browser.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@openai-harness/sdk-protocol": "workspace:*",
    "zod": "^4.6.7",
    "@openai-harness/credentials": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
