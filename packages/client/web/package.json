{
  "name": "@openai-harness/client-web",
  "description": "Web boot kernel: root Cordis Context, UI-renderer activation, and the application mount handoff",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  },
  "dependencies": {
    "@openai-harness/client-ui-renderer": "workspace:*",
    "@openai-harness/client-ui-slots": "workspace:*",
    "@openai-harness/session-controller": "workspace:*",
    "@openai-harness/client-rpc": "workspace:*",
    "@openai-harness/client-ui-chat": "workspace:*",
    "@openai-harness/client-ui-connectors": "workspace:*",
    "@openai-harness/client-ui-detail-bar": "workspace:*",
    "@openai-harness/client-ui-landing": "workspace:*",
    "@openai-harness/client-ui-layout": "workspace:*",
    "@openai-harness/client-ui-modals": "workspace:*",
    "@openai-harness/client-ui-profile": "workspace:*",
    "@openai-harness/client-ui-report": "workspace:*",
    "@openai-harness/client-ui-session": "workspace:*",
    "@openai-harness/client-ui-sidebar": "workspace:*",
    "@openai-harness/client-ui-theme": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*"
  }
}
