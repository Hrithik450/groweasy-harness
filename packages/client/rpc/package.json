{
  "name": "@openai-harness/client-rpc",
  "description": "Framework-free browser RPC client for the harness gateway: unary calls and reconnecting follow subscriptions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/api-gateway": "workspace:*",
    "@openai-harness/client-connection": "workspace:*",
    "@openai-harness/sdk-protocol": "workspace:*"
  },
  "devDependencies": {
    "@openai-harness/session": "workspace:*"
  }
}
