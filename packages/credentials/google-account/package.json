{
  "name": "@openai-harness/google-account",
  "description": "Google OAuth 2.0 URL building, authorization-code exchange, and OpenID profile fetch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/host-webserver": "workspace:*",
    "@openai-harness/credentials": "workspace:*",
    "@openai-harness/uuid": "workspace:*"
  }
}
