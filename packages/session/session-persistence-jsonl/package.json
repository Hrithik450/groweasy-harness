{
  "name": "@openai-harness/session-persistence-jsonl",
  "description": "Append-only JSONL session log provider: header-first generation files, contiguous seq, atomic publish, cross-process lease",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@openai-harness/session": "workspace:*"
  }
}
