# Dependencies
node_modules/

# Next.js / build output
.next/
out/
build/
dist/
*.tsbuildinfo

# Runtime state: SQLite is written on every request, so the dev watcher must
# never see it or every read triggers a rebuild and a full page reload.
# Also holds OAuth tokens and user data — never commit.
data/

# Environment secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Editor
.idea/
.vscode/
*.swp

# Test / coverage
coverage/
.nyc_output/

# Keys, certs, local state
*.pem
*.key
*.p12
*.pfx
