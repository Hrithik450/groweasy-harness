OPENAI_API_KEY=your_openai_api_key_here

# Project-local data root. Everything the app persists (databases,
# attachments, backups, tmp) lives under this directory. Relative paths
# resolve against the project root, never $HOME. Default: ./data
DATA_ROOT=./data

# Main application database (event-sourced; legacy DBs live in data/backups).
# Relative paths resolve against the project root.
DATABASE_PATH=./data/groweasy.db

# OpenAI Managed Agents Model
OPENAI_AGENT_MODEL=gpt-6.1-sol
# Bound on one model request's wait for response headers, in milliseconds.
# A provider that accepts the request and goes silent fails here instead of
# holding the turn open. Default: 120000
# OPENAI_REQUEST_TIMEOUT_MS=120000

# OpenAI Image Generation Model
OPENAI_IMAGE_MODEL=gpt-image-2

# Video Generation (BytePlus SeaDance Ark API)
BYTEPLUS_API_KEY=your_byteplus_api_key_here
BYTEPLUS_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
BYTEPLUS_VIDEO_MODEL=dreamina-seedance-2-0-260128
# Optional: retried automatically when the primary model's endpoint is closed
# or not activated for this account (Ark "InvalidEndpoint.ClosedEndpoint").
# BYTEPLUS_VIDEO_FALLBACK_MODEL=

# Voice Synthesis & Speech-to-Speech Conversion (ElevenLabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Lip-Sync Runner (ByteDance LatentSync). Set exactly one of:
#   LIPSYNC_RUNNER_PATH=/path/to/bytedance/lip-sync/run.py   (local runner)
#   MODAL_LIPSYNC_ENDPOINT_URL=https://...modal.run           (remote endpoint)
# Without one, syncLips refuses to run instead of returning an unsynchronized video.
# LIPSYNC_MOCK=true only for tests: skips lip motion and reports that it did.
LIPSYNC_RUNNER_PATH=/path/to/bytedance/lip-sync/run.py

# Meta (Facebook) OAuth 2.0 Credentials & Ad Library Access Token
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN=your_meta_access_token_here

# Shopify App OAuth 2.0 Credentials
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/v1/integrations/shopify/callback

# Apify Web Scraping & Meta Ad Library Scraper API
APIFY_API_TOKEN=your_apify_api_token_here

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
AUTH_SECRET=your_secret_session_jwt_key_at_least_32_chars

# Video Analysis Pipeline (FastAPI microservice for keyframe extraction & Whisper transcription)
VIDEO_ANALYSIS_PIPELINE=http://localhost:8001

# Alternative Web Scraper (Crawl4AI)
ALTERNATIVE_WEB_SCRAPER_URL=http://localhost:11235
ALTERNATIVE_WEB_SCRAPER_TOKEN=crawl4ai_secret_token
# Gateway (apps/gateway). Unary RPC is POST /api/<namespace>/<method> on this
# origin; streams are the WebSocket mux at /api/remote.mux. The browser value is
# the origin only (the client appends the mux path and the /api RPC prefix).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4000
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:4000
# Origins allowed to call the gateway AND to receive the browser back after an
# OAuth callback (Google/Meta/Shopify). The OAuth hop itself always runs on the
# gateway origin — that is the registered redirect_uri — so the UI origin must
# be listed here or the callback falls back to the gateway origin.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare R2 attachment storage
# Tenant namespaces live under openai-harness/t/<tenantId>/ in this bucket.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Optional. Not used by the app: attachments are delivered only through the
# authenticated /api/attachments/<attachmentId> route, never a public bucket URL.
R2_PUBLIC_URL=

# Guardrails (apps/gateway). Every value is optional; the defaults are safe.
# Prompt cap in characters across all text blocks of one admitted prompt.
# GUARDRAILS_MAX_INPUT_CHARS=32000
# Per-session tool-call quota, and a tighter quota for generation tools.
# GUARDRAILS_TOOL_CALLS_PER_MINUTE=120
# GUARDRAILS_GENERATION_CALLS_PER_MINUTE=12
# Comma-separated tool names denied before dispatch (e.g. write tools).
# GUARDRAILS_DENY_TOOLS=createMetaCampaigns,createMetaAd
# Answer PII mode: high (SSN/card/IBAN), all (also email/phone), or off.
# GUARDRAILS_PII=high
# Development only: allow tools to reach loopback/private hosts.
# GUARDRAILS_ALLOW_PRIVATE_HOSTS=0
# Optional fixed marker for the system-prompt canary; defaults to a random
# per-process token so attacker-chosen text cannot force a false block.
# GUARDRAILS_CANARY=
